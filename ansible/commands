#ping for connectivity
ansible local -m ping -i ansible/hosts.ini #path when outside the directory

#runing playbook
ansible-playbook playbook.yml -i hosts.ini

#running on particular group of servers from hosts
ansible-playbook playbook.yml -i hosts.ini -l local

#check without execution
ansible-playbook foo.yml --check

#run playbook with inventory ini file
ansible-playbook -i inventory.ini playbook.yml
